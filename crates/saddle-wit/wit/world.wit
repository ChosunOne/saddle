package saddle:host@0.1.0;

// This is a read-only tool world, not a world that imports every possible capability.
world read-tool {
    import fs-read;
    import fs-read-range;
    import fs-paths;
    import fs-list;
    import tool-result;
    import transcript-read;
    export saddle:plugin/tool@0.1.0;
}
