package saddle:host@0.1.0;

// A filesystem/transcript tool world; the historical name is retained for SDK compatibility.
world read-tool {
    import exec;
    import fs-read;
    import fs-write;
    import fs-read-range;
    import fs-paths;
    import fs-list;
    import tool-result;
    import transcript-read;
    import tool-paths;
    export saddle:plugin/tool@0.1.0;
}
