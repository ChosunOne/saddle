package saddle:host@0.1.0;

// A standard tool world; the historical name is retained for SDK compatibility.
world read-tool {
    import budgets;
    import context-contribute;
    import persist;
    import model-invoke;
    import workers;
    import ui;
    import ask;
    import saddle:widgets/types@0.1.0;
    import plugin-events;
    import http;
    import web-search;
    import exec;
    import exec-tasks;
    import run-binary;
    import fs-read;
    import fs-write;
    import fs-preimage;
    import fs-read-range;
    import fs-paths;
    import fs-list;
    import tool-result;
    import transcript-read;
    import tool-paths;
    export saddle:plugin/tool@0.1.0;
}
