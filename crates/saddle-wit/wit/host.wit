package saddle:host@0.1.0;

interface fs-read {
    record path {
        root: string,
        relative: string,
    }

    variant failure {
        denied(string),
        invalid-path(string),
        io(string),
        too-large,
    }

    read-file: func(path: path) -> result<list<u8>, failure>;
}

// An additive interface keeps existing read-file components binary-compatible.
interface fs-read-range {
    use fs-read.{path, failure};
    record chunk {
        bytes: list<u8>,
        eof: bool,
    }
    read-range: func(path: path, offset: u64, limit: u32) -> result<chunk, failure>;
}
