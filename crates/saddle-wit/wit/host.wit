package saddle:host@0.1.0;

// Public resource settings, not operational authority (D145).
interface budgets { read: func() -> string; }

interface http {
    record header { name: string, value: string }
    record request { url: string, headers: list<header> }
    record response { status: u16, headers: list<header>, body: list<u8>, truncated: bool }
    get: func(request: request) -> result<response, string>;
}

interface web-search {
    record snapshot { query: string, count: u32, via: string, provider: string, status: u16, body: string }
    search: func(query: string, count: u32) -> result<snapshot, string>;
    last: func() -> result<option<snapshot>, string>;
}

// A question put to the person in the interface they are sitting at (D197). Asking grants no
// resource: the tool proposes and the person answers, dismisses or says nobody is there. The
// question's words reach the person, never the audit log, which keeps their length and hash.
interface ask {
    // One choice. `preview` is shown beside the list while this choice is the one selected, so a
    // choice can carry a diff, a sketch or a paragraph without repeating it in every row.
    record choice { label: string, description: string, preview: string }
    // `allow-other` offers a choice whose answer is typed instead of picked; `allow-note` lets the
    // person attach a note to the option they choose.
    record question { question: string, choices: list<choice>, allow-other: bool, allow-note: bool }
    // An index into `choices`, or words the person typed themselves.
    variant selection { chosen(u32), typed(string) }
    // `note` belongs to a chosen choice; it is empty for a typed answer.
    record reply { selection: selection, note: string }
    // `unavailable` says why this session has nobody to ask rather than inventing an answer; a
    // refusal to ask at all is the error half, shaped the way every tool's denial is.
    variant outcome { answered(reply), dismissed, unavailable(string) }
    ask: func(question: question) -> result<outcome, string>;
}

interface exec {
    record command { argv: list<string>, timeout-secs: u64 }
    record reply {
        code: option<s32>, signal: option<s32>, stdout: list<u8>, stderr: list<u8>,
        timed-out: bool, cancelled: bool, truncated: bool,
        denials: list<string>,
    }
    run: func(request: command) -> result<reply, string>;
}

// A protected launch profile is separate from ordinary shell execution (D184).
interface run-binary {
    record reply {
        code: option<s32>, signal: option<s32>, stdout: list<u8>, stderr: list<u8>,
        timed-out: bool, cancelled: bool, truncated: bool,
        denials: list<string>,
    }
    record launch { profile: string, argv: list<string>, timeout-secs: u64 }
    run: func(request: launch) -> result<reply, string>;
    run-with-options: func(request: launch, allow-children: bool) -> result<reply, string>;
}

// Session-owned subprocesses; importing this service grants no resources beyond exec (D153).
interface exec-tasks {
    use exec.{command, reply};
    record task { id: string, running: bool, output: reply }
    start: func(request: command) -> result<task, string>;
    inspect: func(id: string) -> result<task, string>;
    %list: func() -> result<list<task>, string>;
    cancel: func(id: string) -> result<task, string>;
    // Say whether finishing this task should resume the agent (D174). It answers at once: the wake
    // belongs to the session, so this call never waits for the task.
    set-wake: func(id: string, wake: bool) -> result<task, string>;
}

// Independent D138 types are kept for binary compatibility.
// Legacy D138 adapter, retained for existing components; normal filesystem services cover both
// roots and configured external directories under per-request runtime checks (D139).
interface tool-paths {
    record path { root: string, relative: string }
    variant failure { denied(string), invalid-path(string), io(string), too-large }
    record chunk { bytes: list<u8>, eof: bool }
    enum entry-kind { file, directory, symlink, other }
    record entry { name: string, kind: entry-kind }
    record page { entries: list<entry>, total: u32, skipped: u32, more: bool }
    resolve-path: func(value: string) -> result<path, failure>;
    read-range: func(path: path, offset: u64, limit: u32) -> result<chunk, failure>;
    read-directory: func(path: path, after: string, limit: u32) -> result<page, failure>;
}

// A query over one conversation's active branch, never a handle to the saved database. The
// session is empty for the conversation in hand, or names another of this workspace when the
// transcript-read grant covers them (D163).
interface transcript-read {
    query: func(sql: string, session: string) -> result<string, string>;
}

interface fs-read {
    record path {
        root: string,
        relative: string,
    }

    variant failure {
        denied(string),
        invalid-path(string),
        io(string),
        too-large,
    }

    read-file: func(path: path) -> result<list<u8>, failure>;
}

// Mutations carry bytes and explicit optimistic preconditions, not tool workflows (D140).
interface fs-write {
    variant expectation { any, missing, sha256(string) }
    record change {
        path: string,
        content: option<list<u8>>,
        expected: expectation,
    }
    apply: func(changes: list<change>) -> result<_, string>;
}

// An additive interface keeps existing read-file components binary-compatible.
interface fs-read-range {
    use fs-read.{path, failure};
    record chunk {
        bytes: list<u8>,
        eof: bool,
    }
    read-range: func(path: path, offset: u64, limit: u32) -> result<chunk, failure>;
}

interface fs-paths {
    use fs-read.{path, failure};
    resolve-path: func(value: string) -> result<path, failure>;
    label-root: func(root: string) -> result<string, failure>;
}

interface fs-list {
    use fs-read.{path, failure};
    enum entry-kind { file, directory, symlink, other }
    record entry { name: string, kind: entry-kind }
    record page {
        entries: list<entry>,
        total: u32,
        skipped: u32,
        more: bool,
    }
    read-directory: func(path: path, after: string, limit: u32) -> result<page, failure>;
}

// Result presentation carries data, not filesystem or network authority.
interface tool-result {
    emit-diff: func(text: string) -> result<_, string>;
    record image-info {
        media-type: string,
        width: u32,
        height: u32,
    }
    emit-image: func(name: string, bytes: list<u8>) -> result<image-info, string>;
}

// Optional preimages distinguish absence from refusal without altering the legacy failure variant.
interface fs-preimage {
    use fs-read.{path, failure};
    read: func(path: path) -> result<option<list<u8>>, failure>;
}
